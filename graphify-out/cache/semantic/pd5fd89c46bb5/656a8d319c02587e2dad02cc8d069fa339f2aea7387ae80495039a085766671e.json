{"nodes": [{"id": "design_map_utxowallet_minidapp", "label": "utxoWallet MiniDapp (index.html v1.0.52) \u2014 source of truth", "file_type": "document", "source_file": "DESIGN_MAP.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The APK must recreate the dapp exactly, cutting no corners: if a field/behaviour exists in the dapp it exists in the APK."}, {"id": "design_map_design_language_toggle", "label": "Runtime design-language toggle (ORIGINAL / CURRENT)", "file_type": "rationale", "source_file": "DESIGN_MAP.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two switchable design languages chosen in CFG, persisted, applied app-wide via activity recreate(). All view code reads a central Design token object \u2014 never hard-coded colors \u2014 so the toggle is a data swap, not a code fork."}, {"id": "design_map_design_token_object", "label": "Design token object (central tokens)", "file_type": "code", "source_file": "DESIGN_MAP.md", "source_location": "\u00a70, \u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_original_design_language", "label": "ORIGINAL design language (brutalist/terminal, light+dark)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a70, \u00a71.1, \u00a71.2, \u00a71.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faithful to the dapp: monospace everywhere, hard 1px borders, 0 radius, uppercase tracked micro-labels, tabular-nums, hard offset shadows; accent #ff5a1f constant across light (default) and dark (photo-negative) sub-modes."}, {"id": "design_map_current_design_language", "label": "CURRENT design language (native dark Material)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a70, \u00a71.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pre-existing native look: dark #0A0A0F bg, #15151F cards, accent #F7931A, rounded Material buttons, sans-serif. Dark-only."}, {"id": "design_map_theme_toggle", "label": "Light/Dark theme toggle (ORIGINAL only)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a70, \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_component_catalog", "label": "Component catalog (btn, field, card, address card, UTXO row, status pill, modal, tx-row, toast, empty state)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_app_shell", "label": "App shell \u2014 sticky nav + Wallet/Balances/History/CFG tabs", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nav shows brand, theme toggle, design toggle and live block number; Balances/History/CFG are lazy-rendered on tab select."}, {"id": "design_map_wallet_screen", "label": "Wallet screen (selection bar, address cards, coin rows)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_balances_screen", "label": "Balances screen (per-token bal-card)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_history_screen", "label": "History screen (history-row, details, terminal actions)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_history_status_buckets", "label": "History status buckets (Sending/Approve/Re-post/Confirmed/Failed)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_cfg_screen", "label": "CFG (Settings) screen", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_default_change_mode", "label": "defaultChangeMode \u2014 Rotate vs First input", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.4, \u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rotate cycles through the 64 default addresses; First input sends change back to the source coin's address. Default is rotate."}, {"id": "design_map_write_permission_probe", "label": "WRITE permission probe (txncreate\u2192txndelete)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Send is disabled unless WRITE is granted; on broadcast IPC the analog is 'enabled in Minima Core \u2192 Apps'."}, {"id": "design_map_node_lock_state", "label": "Node lock state check", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_send_flow", "label": "Send flow (full UTXO construction modal)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected coins \u2192 recipient (with recognition note) \u2192 amount with max \u2192 editable change address \u2192 optional burn (Minima only) \u2192 Preview \u2192 Confirm. Change is required unless amount+burn == total."}, {"id": "design_map_validateaddress", "label": "validateAddress (0x+64 hex or Mx+40\u2013118 alnum)", "file_type": "code", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_validateamount", "label": "validateAmount (AMOUNT_RE, >0, \u2264 maxSpendable)", "file_type": "code", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_resolvedefaultchangeaddr", "label": "resolveDefaultChangeAddr", "file_type": "code", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_confirm_modal", "label": "Confirm transaction modal (inputs/outputs/change/burn, irreversibility warning)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows every input and output including change and burn plus an irreversibility tx-warn and optional stale-tip warning before Sign & Post, because a signed and posted transaction cannot be undone."}, {"id": "design_map_buildtransaction", "label": "buildTransaction / signAndPost command sequence", "file_type": "code", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 Build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact order: record history (posting) \u2192 txncreate id:uw_\u2026 \u2192 txninput per coin \u2192 txnoutput per recipient \u2192 txnoutput change (if >0) \u2192 txnsign publickey:auto txnpostauto:true txndelete:true [txnpostburn]. History is recorded first so a crash mid-post still leaves a record."}, {"id": "design_map_post_size_guard", "label": "Post-size guard 64KB (estimateTxPowBytes / oversizedPostError)", "file_type": "rationale", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 Build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-flight size estimate (overhead 4096 + 6144 per input + 900 per output) rejects a transaction before posting rather than letting the node reject an oversized TxPoW."}, {"id": "design_map_awaiting_approval_resume", "label": "awaiting_approval \u2192 resume on NEWBLOCK", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.1 Build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In READ-mode/approval the txn is pending; resume is a single-shot signAndPost after txncheck, throttled to every 2 blocks with a 20-block expiry."}, {"id": "design_map_split_flow", "label": "Split flow (2\u201315 coins to fresh own addresses)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_distribute_flow", "label": "Distribute flow (multi-batch, auto-chained, 14 outputs per batch)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MAX_ADDR_OUTPUTS_PER_BATCH = 14; batch1 change funds later batches, found on NEWBLOCK by coinid (fallback addr+amount); no burn on later batches; expiry ~25 blocks."}, {"id": "design_map_distribute_affordability_fix", "label": "Distribute affordability rule (reject only if needed > total)", "file_type": "rationale", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "needed = N\u00d7perAddr + burn; reject ONLY on strict needed > total. needed == total (zero change) is allowed and must not fetch a change address. Fixes the dapp bug that rejected the equal case."}, {"id": "design_map_consolidate_flow", "label": "Consolidate flow (auto consolidate tokenid:0x00 or merge selected)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No selection \u2192 node consolidate command; 2+ selected \u2192 merge exactly those into one output at a fresh address. Full version offers maxcoins/coinage/burn with a dry-run preview and only posts if it reduces the coin count."}, {"id": "design_map_untrack_track_receive", "label": "Untrack / Track (cointrack) / Receive (QR)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a75.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_state_persistence", "label": "State & persistence (SharedPreferences + local SQLite history)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "theme, designLanguage, defaultChangeMode, distributeJob persist in SharedPreferences; history rows (internalid, txnid, status, inputs/outputs JSON, changeaddr, burn, postblock\u2026) live in the app's own SQLite rather than relying on the node's history."}, {"id": "design_map_ipc_events_newblock_newbalance", "label": "IPC NOTIFY events \u2014 NEWBLOCK / NEWBALANCE", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NEWBLOCK drives block number, coin reload, pending resume, confirmation watching and distribute chaining; NEWBALANCE triggers a debounced reload."}, {"id": "design_map_selection_model", "label": "Selection model (selected set, selectedTokenid lock, sendableCoinIds)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-tokenid lock: tapping a coin of a different token clears the selection, so one transaction never mixes tokens."}, {"id": "design_map_command_reference", "label": "Node command reference over MinimaAPI.Command", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_minima_explorer", "label": "Minima Explorer transaction link", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a74.3, \u00a77", "source_url": "https://explorer.minima.global/transactions/", "captured_at": null, "author": null, "contributor": null}, {"id": "design_map_build_order", "label": "Build order (tokens \u2192 shell \u2192 Wallet \u2192 Send \u2192 Balances \u2192 History \u2192 CFG \u2192 tools \u2192 review \u2192 release)", "file_type": "concept", "source_file": "DESIGN_MAP.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_map_design_language_toggle", "target": "design_map_original_design_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "design_map_design_language_toggle", "target": "design_map_current_design_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "design_map_design_language_toggle", "target": "design_map_design_token_object", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN_MAP.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "design_map_original_