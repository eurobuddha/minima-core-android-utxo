{"nodes": [{"id": "readme_minima_utxo_wallet", "label": "Minima UTXO Wallet (native Android)", "file_type": "document", "source_file": "README.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_explicit_utxo_selection", "label": "Explicit UTXO (coin) selection", "file_type": "rationale", "source_file": "README.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick exactly which coins are spent, construct the whole transaction and review it before signing \u2014 full control instead of the node's automatic coin selection."}, {"id": "readme_broadcast_intent_ipc", "label": "Broadcast-Intent IPC via minimaapi (no MDS, no RPC, no browser)", "file_type": "concept", "source_file": "README.md", "source_location": "intro, Build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native Java talks to the local Minima Core node only over the node's broadcast-Intent IPC; the app must be enabled in Minima Core \u2192 Apps to authorize it."}, {"id": "readme_minima_core", "label": "Minima Core node", "file_type": "concept", "source_file": "README.md", "source_location": "intro", "source_url": "https://minima.global", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_history_feature", "label": "History \u2014 bounded + lazy node history plus own postings", "file_type": "concept", "source_file": "README.md", "source_location": "Features", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node history is fetched bounded and lazily so it never overloads the node; the wallet's own postings (posting/posted/failed, with node error and every input coinid copyable) are layered on top, and a posting is confirmed against the on-chain txpow that spent its inputs."}, {"id": "readme_burn_semantics", "label": "Burn realised as inputs\u2212o