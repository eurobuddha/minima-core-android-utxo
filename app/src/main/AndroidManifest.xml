<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Token icon graphics may live at remote/IPFS URLs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: needed to launch the node app and to deliver
         our targeted (setPackage) IPC broadcasts to it -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <!-- allowBackup=false: the whole apks/ fleet was scaffolded with allowBackup="true" and empty backup
         rules, so Android Auto Backup uploaded each app's entire data directory to the user's cloud and
         restored it on reinstall. Harmless-looking apps still carried the node pairing token, and a
         reinstall must be a true reset everywhere, not just in the apps holding keys.
         At stake here: utxo_history.db (a transaction cache), the airdrop/distribute job state and design prefs, plus the shared
         minima_api_prefs node pairing token. No keys are stored — the wallet is the node's — but a restored
         distribute job and a stale pairing token both belong to a node this install may no longer be talking to -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Utxo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
